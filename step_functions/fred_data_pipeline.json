{
  "Comment": "FRED Data Pipeline",
  "StartAt": "Invoke Ingestion Lambda",
  "States": {
    "Invoke Ingestion Lambda": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:<region>:<account-id>:function:fred-api-ingestion:$LATEST",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "raw_path.$": "$.Payload.raw_path"
      },
      "ResultPath": "$.ingestion",
      "Next": "Start Glue Transform Job",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Notify Failure"
        }
      ]
    },
    "Start Glue Transform Job": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "fred_transform",
        "Arguments": {
          "--raw_path.$": "$.ingestion.raw_path"
        }
      },
      "ResultPath": "$.transformJob",
      "Next": "Should Run Crawler",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Notify Failure"
        }
      ]
    },
    "Should Run Crawler": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Start Glue Crawler",
          "And": [
            {
              "Variable": "$.runCrawler",
              "IsPresent": true
            },
            {
              "Variable": "$.runCrawler",
              "BooleanEquals": true
            }
          ]
        }
      ],
      "Default": "Pipeline Succeeded"
    },
    "Start Glue Crawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "fred_data_lake_crawler"
      },
      "ResultPath": "$.crawler",
      "Next": "Pipeline Succeeded",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Notify Failure"
        }
      ]
    },
    "Pipeline Succeeded": {
      "Type": "Succeed"
    },
    "Notify Failure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "Message.$": "$",
        "TopicArn": "arn:aws:sns:<region>:<account-id>:fred-pipeline-alerts"
      },
      "Next": "Pipeline Failed"
    },
    "Pipeline Failed": {
      "Type": "Fail"
    }
  },
  "QueryLanguage": "JSONPath"
}